<Window x:Class="Python.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Python" Width="1100" Height="640"
        WindowStartupLocation="CenterScreen" Background="#0A2A6B">
    <Grid>
        <!-- Background from the Assets folder, shared by every screen -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/background.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <ContentControl x:Name="Host"/>
    </Grid>
</Window>
