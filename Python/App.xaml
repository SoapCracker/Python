<Application x:Class="Python.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Pixel font from the Fonts folder -->
        <FontFamily x:Key="PixelFont">pack://application:,,,/Fonts/#Press Start 2P</FontFamily>

        <!-- Main menu button -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#39D353"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,9"/>
            <Setter Property="Width" Value="380"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="#0A160A"
                                BorderBrush="#39D353" BorderThickness="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#123312"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smaller button for settings / back -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="48"/>
        </Style>

    </Application.Resources>
</Application>
