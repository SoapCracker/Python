<UserControl x:Class="Python.Screens.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D7F7E0"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Kop" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#39D353"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#D9091109" CornerRadius="12" BorderBrush="#39D353" BorderThickness="3"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26" Width="640">
        <StackPanel>
            <TextBlock Text="Instellingen" FontFamily="{StaticResource PixelFont}" FontSize="26"
                       Foreground="#39D353" HorizontalAlignment="Center"/>

            <TextBlock Text="Moeilijkheid" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DiffMakkelijk" GroupName="diff" Content="Makkelijk"/>
                <RadioButton x:Name="DiffMoeilijk" GroupName="diff" Content="Moeilijk"/>
            </StackPanel>

            <TextBlock Text="Niveau" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Lvl1" GroupName="lvl" Content="1 (7x7)"/>
                <RadioButton x:Name="Lvl2" GroupName="lvl" Content="2 (10x10)"/>
                <RadioButton x:Name="Lvl3" GroupName="lvl" Content="3 (14x14)"/>
            </StackPanel>

            <TextBlock Text="Onderwerp" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TopicTalen" GroupName="topic" Content="Programmeertalen"/>
                <RadioButton x:Name="TopicWiskunde" GroupName="topic" Content="Wiskunde"/>
            </StackPanel>

            <TextBlock Text="Power-ups" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PowerAan" GroupName="power" Content="Aan"/>
                <RadioButton x:Name="PowerUit" GroupName="power" Content="Uit"/>
            </StackPanel>

            <TextBlock Text="Snelheid" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SpeedLangzaam" GroupName="speed" Content="Langzaam"/>
                <RadioButton x:Name="SpeedNormaal" GroupName="speed" Content="Normaal"/>
                <RadioButton x:Name="SpeedSnel" GroupName="speed" Content="Snel"/>
            </StackPanel>

            <TextBlock Text="Skin" Style="{StaticResource Kop}"/>
            <StackPanel Orientation="Horizontal" x:Name="SkinPanel">
                <Button Tag="#57C785" Background="#57C785" Width="52" Height="38" Margin="0,0,10,0" BorderThickness="0" Click="Skin_Click"/>
                <Button Tag="#4F8AD4" Background="#4F8AD4" Width="52" Height="38" Margin="0,0,10,0" BorderThickness="0" Click="Skin_Click"/>
                <Button Tag="#ECC94B" Background="#ECC94B" Width="52" Height="38" Margin="0,0,10,0" BorderThickness="0" Click="Skin_Click"/>
                <Button Tag="#A97FE0" Background="#A97FE0" Width="52" Height="38" Margin="0,0,10,0" BorderThickness="0" Click="Skin_Click"/>
            </StackPanel>

            <Button Content="Terug" Style="{StaticResource SmallButton}" Margin="0,28,0,0"
                    HorizontalAlignment="Center" Click="Back_Click"/>
        </StackPanel>
    </Border>
</UserControl>
