<UserControl x:Class="Python.Screens.GameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True"
             Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewKeyDown="OnKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HUD: lives, question, score, time -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LivesText" Grid.Column="0" FontFamily="{StaticResource PixelFont}"
                       FontSize="13" Foreground="#E5573F" VerticalAlignment="Center"/>
            <TextBlock x:Name="QuestionText" Grid.Column="1" FontFamily="{StaticResource PixelFont}"
                       FontSize="14" Foreground="#39D353" TextAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock x:Name="ScoreText" FontFamily="{StaticResource PixelFont}" FontSize="13"
                           Foreground="#ECC94B" TextAlignment="Right"/>
                <TextBlock x:Name="TimeText" FontFamily="{StaticResource PixelFont}" FontSize="13"
                           Foreground="#D7F7E0" TextAlignment="Right" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Board -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#39D353" BorderThickness="2" Background="#06130B">
            <Canvas x:Name="Board" Width="560" Height="560"/>
        </Border>

        <!-- Hint / controls -->
        <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource PixelFont}" FontSize="10" Foreground="#9FD8B6"/>

        <!-- Game over -->
        <Border x:Name="Overlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#0A160A" BorderBrush="#39D353" BorderThickness="3" CornerRadius="12"
                    Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <StackPanel>
                    <TextBlock Text="Game Over" FontFamily="{StaticResource PixelFont}" FontSize="26"
                               Foreground="#E5573F" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinalScore" FontFamily="{StaticResource PixelFont}" FontSize="15"
                               Foreground="#ECC94B" HorizontalAlignment="Center" Margin="0,16,0,18"/>
                    <TextBlock Text="Naam:" FontFamily="{StaticResource PixelFont}" FontSize="12"
                               Foreground="#D7F7E0"/>
                    <TextBox x:Name="NameBox" MaxLength="12" FontSize="16" Margin="0,6,0,16" Padding="6,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Opslaan" Style="{StaticResource SmallButton}" Width="150" Margin="5,0" Click="Save_Click"/>
                        <Button Content="Opnieuw" Style="{StaticResource SmallButton}" Width="150" Margin="5,0" Click="Again_Click"/>
                        <Button Content="Menu" Style="{StaticResource SmallButton}" Width="120" Margin="5,0" Click="Menu_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SavedText" Text="Opgeslagen!" FontFamily="{StaticResource PixelFont}"
                               FontSize="11" Foreground="#39D353" HorizontalAlignment="Center"
                               Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
