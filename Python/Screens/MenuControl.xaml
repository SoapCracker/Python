<UserControl x:Class="Python.Screens.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Python" FontFamily="{StaticResource PixelFont}" FontSize="64"
                   Foreground="#39D353" HorizontalAlignment="Center" Margin="0,0,0,34">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="4" BlurRadius="4" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>
        <Button Content="Start" Style="{StaticResource MenuButton}" Click="Start_Click"/>
        <Button Content="Highscores" Style="{StaticResource MenuButton}" Click="Highscores_Click"/>
        <Button Content="Instellingen" Style="{StaticResource MenuButton}" Click="Settings_Click"/>
        <Button Content="Informatie" Style="{StaticResource MenuButton}" Click="Information_Click"/>
        <Button Content="Afsluiten" Style="{StaticResource MenuButton}" Click="Quit_Click"/>
    </StackPanel>
</UserControl>